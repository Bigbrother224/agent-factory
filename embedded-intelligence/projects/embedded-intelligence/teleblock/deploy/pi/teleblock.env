# /etc/teleblock/teleblock.env — read by teleblock.service
#
# Arguments handed to /usr/local/bin/teleblock. The listen address stays on
# 0.0.0.0:53 so the Pi can be the LAN DNS gateway; --upstream is where the
# queries teleblock allows are forwarded.
#
# Edit this file on the card's boot partition before the first boot, or over
# SSH afterwards, then: sudo systemctl restart teleblock.service
TELEBLOCK_ARGS=serve --listen 0.0.0.0:53 --upstream 1.1.1.1:53
